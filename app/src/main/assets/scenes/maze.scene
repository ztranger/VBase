tower     pos -18 0 -5

# --- Спавнеры (восток) ---
spawner   pos 20 0 8
spawner   pos 20 0 -8

# --- Игрок ---
player model models/Mage.glb pos -20 0 10 scale 1.0 hide wand,spellbook
