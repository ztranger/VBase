# DFS-лабиринт 6x6 комнат (seed 7): идеальный лабиринт — ровно один путь
# от спавнера (комната ЮЗ) до ядра (комната СВ). Коридоры в 2 клетки.

# --- Текстуры / материалы / меши ---
texture checker procedural 256 8
texture crate   image textures/crate.png
material floor lit   color 1 1 1          tex checker
material crate lit   color 1 1 1          tex crate
material edge  lit   color 0.55 0.65 0.85 tex checker
mesh ground plane 42 21
mesh box    cube  1

# --- Свет / камера / сетка ---
light  dir 0.4 1 0.6
camera distance 46 pitch 1.15
grid   cell 2 arena 19
matchrestart 8

object ground mat floor
ring box mat edge count 64 radius 20 y 0.4 scale 0.4 spin 0.6

# --- Границы арены (коллайдеры) ---
collider box center 0 -0.5 0  half 21 0.5 21   # пол
collider box center  21 1 0  half 0.25 1 21   # стена +X
collider box center -21 1 0  half 0.25 1 21   # стена -X
collider box center 0 1  21  half 21 1 0.25   # стена +Z
collider box center 0 1 -21  half 21 1 0.25   # стена -Z

# --- Стены лабиринта ---
