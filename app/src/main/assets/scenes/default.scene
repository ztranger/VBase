# Сцена по умолчанию VBase. Формат: одна директива на строку, '#' — комментарий.
# Ссылки (mat/tex) — по именам, объявленным выше.

# --- Текстуры ---
texture checker procedural 256 8            # процедурная шахматка
texture crate   image textures/crate.png    # если файла нет -> материал станет белым

# --- Материалы: <name> <shader> [color r g b] [tex <ref>] ---
material floor lit   color 1 1 1            tex checker
material crate lit   color 1 1 1            tex crate
material red   phong color 0.90 0.35 0.30
material green unlit  color 0.30 0.85 0.45
material blue  phong color 0.35 0.55 0.95
material gold  phong color 0.95 0.80 0.25
material edge  lit   color 0.55 0.65 0.85   tex checker

# --- Меши-примитивы ---
mesh ground plane  24 12    # size 24, UV-тайлинг 12
mesh box    cube   1
mesh ball   sphere 0.6

# --- Свет и камера ---
light  dir 0.4 1 0.6
camera distance 18 pitch 0.9        # ¾-вид: наклон ~51°, зум/орбита — правым стиком/стрелками
grid   cell 2 arena 11              # строительная сетка: размер клетки и полуразмер зоны стройки

# --- Объекты окружения ---
object ground mat floor

object box mat crate pos -4 0.5 -4 spin 0.6
object box mat red   pos  0 0.5 -4 spin 0.9
object box mat green pos  4 0.5 -4 spin 1.2

object ball mat blue pos -4 0.6 4
object ball mat gold pos  0 0.6 4
object ball mat red  pos  4 0.6 4

# Кольцо инстансных кубов по краю (демо инстансинга)
ring box mat edge count 48 radius 10 y 0.4 scale 0.4 spin 1.2

# --- Коллайдеры физики (независимы от визуальных мешей) ---
# collider box center <x y z> half <hx hy hz>
collider box center 0 -0.5 0  half 12 0.5 12       # пол (верх на y=0)
collider box center 12 1 0    half 0.25 1 12        # стена +X (граница поля)
collider box center -12 1 0   half 0.25 1 12        # стена -X
collider box center 0 1 12    half 12 1 0.25         # стена +Z
collider box center 0 1 -12   half 12 1 0.25         # стена -Z
collider box center -4 0.5 -4 half 0.5 0.5 0.5       # куб-препятствие
collider box center 0 0.5 -4  half 0.5 0.5 0.5
collider box center 4 0.5 -4  half 0.5 0.5 0.5

# --- Здания базы: только РАЗМЕЩЕНИЕ; параметры (rate/cap/interval/max) и тексты —
# из config/buildings.cfg. Директивы: generator/storage/spawner/core pos <x y z>.
generator pos -2 0 -6
storage   pos  2 0 -6
core      pos  0 0 -8              # ядро базы — цель врагов (hp из конфига)
spawner   pos  9 0 -8             # плодит врагов, бегут к ядру (путь по z=-8 чист)
tower     pos  4 0 -6             # башня-защита (урон/радиус/интервал из конфига)
tower     pos  4 0 -10            # вторая башня — фланкируют путь врагов

# --- Управляемый персонаж (glTF + скиннинг) ---
# capsule <radius> <cylHalf> — кинематический контроллер (по умолчанию 0.3 0.3)
player model models/Fox.glb pos 0 0 0 scale 0.03
