# Альтернативная сцена (пример: другой свет, кольцо сфер вместо кубов).
texture grid procedural 512 16

material ground lit   color 0.8 0.85 0.9  tex grid
material warm   phong color 0.95 0.55 0.25
material cool   phong color 0.30 0.70 0.95

mesh floor plane  40 20
mesh ball  sphere 0.8

light  dir -0.5 1 0.2
camera distance 8 height 4

object floor mat ground

object ball mat warm pos -3 0.8 0
object ball mat cool pos  3 0.8 0

# Кольцо сфер по краю арены
ring ball mat cool count 32 radius 14 y 0.8 scale 0.6 spin 0.4

player model models/Fox.glb pos 0 0 0 scale 0.04
