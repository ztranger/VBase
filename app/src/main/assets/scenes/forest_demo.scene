# ============================================================================
# Лес: тропа к базе (Г-образная тропа с поворотом) — демо из KayKit Forest (CC0).
# Мобы: спавн на ВОСТОКЕ полосы A -> на запад -> угол (СЗ) -> на юг по полосе B -> ядро (ЮЗ).
# Полосы широкие (~10 ю). Внутренний угол (поляна) отгорожен от тропы: башни там бьют обе
# полосы СБОКУ (энфилада). Невидимые collider box задают путь; лес рисует кромку.
# Сгенерировано scratchpad/gen_forest_demo.py (seed 4242). Правь свободно в редакторе.
# ============================================================================

# --- Текстуры / материалы / меши ---
texture grass image textures/grass.png
material floor ground color 1 1 1 tex grass
mesh ground plane 240 60

# --- Свет / камера / сетка / матч / горизонт ---
light   dir 0.5 1.0 0.35
camera  distance 34 pitch 0.98 fov 0.9
grid    cell 2 arena 16
horizon 0.58 0.66 0.70
matchrestart 8

# Большой пол (шейдер ground): дальняя земля плавно уходит в цвет горизонта — без обрыва/черноты.
object ground mat floor

# --- Пол + невидимые стены Г-образной тропы ---
collider box center 0 -0.5 0    half 24 0.5 24      # пол
# внешние стены
collider box center 0 1 14       half 14 1.4 0.4     # север полосы A
collider box center -14 1 0      half 0.4 1.4 14     # запад полосы B
collider box center 14 1 9       half 0.4 1.4 5      # восточная крышка (за спавнерами)
collider box center -9 1 -14     half 5 1.4 0.4      # южная крышка (за ядром)
# внутренние стены (отделяют поляну от тропы; стык в точке (-4,4))
collider box center 5 1 4        half 9 1.4 0.4      # южная кромка полосы A
collider box center -4 1 -5      half 0.4 1.4 9      # восточная кромка полосы B

# --- База (ЮЗ, конец полосы B) ---
core      pos -9 0 -12
generator pos -12 0 -13
storage   pos -6 0 -13
# --- Стартовые башни В ПОЛЯНЕ (внутренний угол) — простреливают обе полосы сбоку ---
tower     pos -1 0 1
tower     pos 6 0 1
tower     pos -1 0 -6

# --- Спавнеры (восток полосы A) — волны из config/buildings.cfg ---
spawner   pos 13 0 7
spawner   pos 13 0 11

# --- Игрок (у базы, в полосе B) ---
player model models/Mage.glb pos -9 0 -9 scale 1.0 hide wand,spellbook

# --- Декор: лес (деревья/камни/кусты/трава), 135 объектов ---
object model models/forest/Tree_2_D.glb shader lit pos -14.44 0 15.14 rot 0 1.729 0 scale 1.04
object model models/forest/Tree_1_A.glb shader lit pos -11.29 0 14.59 rot 0 4.222 0 scale 1.14
