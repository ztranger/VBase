# Концентрические кольца с проходами на разных сторонах: мобы закручиваются
# к центру по спирали. Ядро в центре, спавнеры снаружи.

# --- Текстуры / материалы / меши ---
texture checker procedural 256 8
texture crate   image textures/crate.png
material floor lit   color 1 1 1          tex checker
material crate lit   color 1 1 1          tex crate
material edge  lit   color 0.55 0.65 0.85 tex checker
mesh ground plane 48 24
mesh box    cube  1

# --- Свет / камера / сетка ---
light  dir 0.4 1 0.6
camera distance 42 pitch 1.1
grid   cell 2 arena 22
matchrestart 8

object ground mat floor
ring box mat edge count 64 radius 23 y 0.4 scale 0.4 spin 0.6

# --- Границы арены (коллайдеры) ---
collider box center 0 -0.5 0  half 24 0.5 24   # пол
collider box center  24 1 0  half 0.25 1 24   # стена +X
collider box center -24 1 0  half 0.25 1 24   # стена -X
collider box center 0 1  24  half 24 1 0.25   # стена +Z
collider box center 0 1 -24  half 24 1 0.25   # стена -Z

