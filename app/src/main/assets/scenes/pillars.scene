# --- База (запад) ---
core      pos -17 0 0
generator pos -19 0 4
storage   pos -19 0 -4
tower     pos -17 0 6
tower     pos -17 0 -6

# --- Спавнеры (восток) ---
spawner   pos 19 0 6
spawner   pos 19 0 -6

# --- Игрок ---
player model models/Mage.glb pos -17 0 8 scale 1.0 hide wand,spellbook
