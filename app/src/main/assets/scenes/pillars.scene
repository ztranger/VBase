# Лес колонн: решётка одиночных препятствий с коридорами в 1 клетку.
# Мобы петляют между колонн к ядру. Проверка потока в плотной решётке.

# --- Текстуры / материалы / меши ---
texture checker procedural 256 8
texture crate   image textures/crate.png
material floor lit   color 1 1 1          tex checker
material crate lit   color 1 1 1          tex crate
material edge  lit   color 0.55 0.65 0.85 tex checker
mesh ground plane 44 22
mesh box    cube  1

# --- Свет / камера / сетка ---
light  dir 0.4 1 0.6
camera distance 40 pitch 1.05
grid   cell 2 arena 20
matchrestart 8

object ground mat floor
ring box mat edge count 64 radius 21 y 0.4 scale 0.4 spin 0.6

# --- Границы арены (коллайдеры) ---
collider box center 0 -0.5 0  half 22 0.5 22   # пол
collider box center  22 1 0  half 0.25 1 22   # стена +X
collider box center -22 1 0  half 0.25 1 22   # стена -X
collider box center 0 1  22  half 22 1 0.25   # стена +Z
collider box center 0 1 -22  half 22 1 0.25   # стена -Z

# --- Колонны: клетки с чётными cx,cz в центральной зоне ---
object box mat crate pos -11 0.9 -11 scale 1.8
collider box center -11 0.9 -11 half 0.9 0.9 0.9
object box mat crate pos -11 0.9 -7 scale 1.8
collider box center -11 0.9 -7 half 0.9 0.9 0.9
object box mat crate pos -11 0.9 -3 scale 1.8
collider box center -11 0.9 -3 half 0.9 0.9 0.9
