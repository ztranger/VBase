# Gradle files
.gradle/

# Native/Android build trees. A bare `build/` also matches third_party/jolt/Build
# on Windows (case-insensitive ignore) and drops Jolt's CMake from git: local
# Docker still works (files on disk), a cloud clone does not.
/build/
/app/build/
/server/build/
/desktop/build/

# Python bytecode (tools/)
__pycache__/
*.pyc

# Generated preview (tools/gen_scene_previews.py default output)
/scene_previews.html

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

.kotlin/

# SPIR-V шейдеры (app/src/main/assets/shaders/vk/*.spv) НАМЕРЕННО коммитятся — чтобы чистый
# clone собирал рабочий Vulkan без внешнего Vulkan SDK (Android пакует их как ассеты). Регенерация
# и проверка актуальности — app/src/main/cpp/shaders/gen_vk_shaders.py (+ --check в CI). Не игнорим.
